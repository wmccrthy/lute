--!strict
local editor = require("../../batteries/editor")
local task = require("@std/task")
local workspace = editor.workspace()
local cleaned, received, late = 0, 0, 0
workspace:registerpane("scoped", function(ctx)
    local label = ctx.ui.text("scope ready")
    ctx:onclose(function() cleaned += 1 end)
    ctx:on("probe", function() received += 1 end)
    ctx:spawn(function()
        task.wait(0.01)
        ctx:emit("probe", nil)
        label:settext("job complete")
    end)
    ctx:spawn(function() task.wait(0.15); late += 1 end)
    ctx:spawn(function()
        task.wait(0.04)
        workspace:closepane(ctx.id, true)
        workspace:emit("probe", nil)
        workspace:quit(true)
    end)
    return {title = "Scope", view = label}
end)
workspace:openpane("scoped")
workspace:run()
assert(cleaned == 1 and received == 1 and late == 0, "pane resources outlived their scope")
