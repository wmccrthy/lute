--!strict
-- Driven by tools/test_tui.py inside a real pseudo-terminal.
local tui = require("@std/tui")
local task = require("@std/task")
local process = require("@std/process")
local io = require("@lute/io")
local mode = select(2, ...)

local function rejects(callback: () -> ())
    assert(not pcall(callback), "expected an API error")
end

if mode == "notty" then
    assert(not tui.supported())
    rejects(function()
        tui.open()
    end)
elseif mode == "lifecycle" then
    local term = tui.open()
    rejects(function()
        tui.open()
    end)
    rejects(function()
        io.read()
    end)
    rejects(function()
        io.write("must not escape the frame")
    end)
    rejects(function()
        term:text(1, 1, "bad", { fg = "#zzzzzz" })
    end)
    rejects(function()
        term:text(1, 1, "bad", { fg = 1.5 })
    end)
    term:text(1, 1, "ready", { fg = "#82aaff" })
    term:present()
    local event = term:read()
    assert(event.kind == "key" and event.key == "up" and event.ctrl)
    event = term:read()
    assert(event.kind == "paste" and event.text == "hello\27[A")
    event = term:read()
    assert(event.kind == "mouse" and event.x == 12 and event.y == 3)
    event = term:read()
    assert(event.kind == "key" and event.key == "escape")
    term:close()
    term:close()
    rejects(function()
        term:present()
    end)
    -- A new session must be usable while old uv_close callbacks drain.
    tui.run(nil, function(nextterm)
        nextterm:text(1, 1, "reopened")
        nextterm:present()
    end)
elseif mode == "error" then
    local ok, problem = pcall(function()
        tui.run(nil, function(term)
            term:text(1, 1, "ready")
            term:present()
            term:read()
            error("application failure")
        end)
    end)
    assert(not ok and tostring(problem):find("application failure", 1, true))
    tui.run(nil, function(term)
        term:present()
    end)
elseif mode == "resize" then
    tui.run(nil, function(term)
        term:text(1, 1, "ready")
        term:present()
        local event = term:read()
        assert(event.kind == "resize" and event.width == 100 and event.height == 40)
        local width, height = term:size()
        assert(width == 100 and height == 40)
        term:present()
    end)
elseif mode == "pending" then
    local term = tui.open()
    local finished = false
    task.spawn(function()
        local ok = pcall(function()
            term:read()
        end)
        assert(not ok)
        finished = true
    end)
    task.wait(0.02)
    rejects(function()
        term:read()
    end)
    term:close()
    task.wait(0.02)
    assert(finished)
elseif mode == "shutdown" then
    local term = tui.open()
    term:text(1, 1, "ready")
    term:present()
    -- Deliberately leave it open: the runtime must still terminate and restore.
elseif mode == "exit" then
    local term = tui.open()
    term:text(1, 1, "ready")
    term:present()
    process.exit(0)
elseif mode == "signal" then
    tui.run(nil, function(term)
        term:text(1, 1, "ready")
        term:present()
        term:read()
    end)
else
    error(`unknown test mode {tostring(mode)}`)
end
